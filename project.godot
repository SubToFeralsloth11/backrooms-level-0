; Engine configuration file.
config_version=5

[application]

config/name="The Backrooms - Level 0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Audio="*res://scripts/audio.gd"
Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[physics]

common/physics_ticks_per_second=60
common/physics_jitter_fix=0.0

[rendering]

anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=false
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/ssao/quality=1
environment/ssao/half_size=true
environment/volumetric_fog/volume_size=48
environment/volumetric_fog/volume_depth=48
environment/volumetric_fog/use_filter=false
scaling_3d/mode=1
textures/default_filters/anisotropic_filtering_level=4
